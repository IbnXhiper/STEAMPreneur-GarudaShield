# Caddyfile — TLS terminator + reverse proxy for GarudaShield v3.
#
# Caddy obtains/renews TLS certs automatically (Let's Encrypt in prod, or a local
# CA / self-signed for internal use). The engine itself runs plaintext on :8080
# inside the docker network; Caddy is the only thing exposed to the internet.
#
# Replace garudashield.example.com with your real hostname. For local testing
# with a self-signed cert, Caddy still works — just accept the browser warning.

{
    # Local testing: use Caddy's local CA (self-signed). Comment out for prod
    # Let's Encrypt (which needs a real public hostname + port 80/443 open).
    local_certs
    admin off
}

localhost {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Admin/dashboard API: forward the real client IP to the engine.
    reverse_proxy engine:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        health_uri /api/status
        health_interval 10s
    }
}
